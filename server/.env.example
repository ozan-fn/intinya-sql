# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection string
# Example: postgresql://user:password@host:port/database
DATABASE_URL=

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Port for the backend server
PORT=3001

# API URL for client requests
VITE_API_URL=http://localhost:3001

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# ===========================================
# BETTER AUTH CONFIGURATION
# ===========================================
# Base URL for Better Auth
BETTER_AUTH_URL=http://localhost:3001

# Secret key for Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Auth URL for client-side
VITE_AUTH_URL=http://localhost:3001

# ===========================================
# OAUTH PROVIDERS
# ===========================================

# Discord OAuth
# Get credentials from: https://discord.com/developers/applications
# Redirect URI: http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
